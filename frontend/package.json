{
  "name": "lead-management-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json index.html package.json .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json index.html package.json .prettierrc.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  }
}
